# =============================================================================
# Hudaya Enterprises — PRODUCTION environment template
# Copy to ".env" ON THE SERVER and fill in the values marked <…>.
# Never commit the real .env, never upload it to a public folder, never email it.
# Generate APP_KEY on the server with:  php artisan key:generate
# =============================================================================

APP_NAME="Hudaya Enterprises"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Full https address, no trailing slash. Used for links in emails, sitemap and canonical URLs.
APP_URL=https://<your-domain>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Daily log files in storage/logs, kept 14 days; only warnings and errors.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- MySQL -----------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<database-name>
# A dedicated database user — never root.
DB_USERNAME=<database-user>
DB_PASSWORD=<strong-password>

# --- Sessions (admin login) -------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies only over https — SSL must be active first.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Only on hosting WITHOUT symlink support (see docs/DEPLOYMENT.md §A6):
# PUBLIC_STORAGE_ROOT=/home/<account>/public_html/storage

# Inquiry emails are sent straight away (no queue worker needed).
QUEUE_CONNECTION=sync
CACHE_STORE=database

# --- Email (inquiry notifications) ---------------------------------------------
# Use the SMTP account from your hosting / email provider. Inquiries are always saved
# in Admin → Inquiries, even if email sending fails.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM_ADDRESS="<no-reply@your-domain>"
MAIL_FROM_NAME="${APP_NAME}"

# --- Only behind a proxy / CDN that terminates HTTPS (Cloudflare, load balancer) ---
# TRUSTED_PROXIES=*

VITE_APP_NAME="${APP_NAME}"
